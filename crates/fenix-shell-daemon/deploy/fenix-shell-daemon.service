[Unit]
Description=Fenix Desktop System State Daemon
Documentation=https://github.com/javiju/fenix-hub
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/fenix-shelld
Restart=on-failure
RestartSec=2s
Environment=RUST_LOG=info

[Install]
WantedBy=graphical-session.target
