{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FenixHub",
  "version": "0.1.0",
  "identifier": "dev.fenix.hub",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1421"
  },
  "app": {
    "windows": [
      {
        "label": "hub",
        "title": "FenixHub",
        "width": 480,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
