{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FenixHub",
  "version": "0.2.3",
  "identifier": "dev.fenix.hub",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": { "script": "bun run dev", "cwd": "../frontend" },
    "beforeBuildCommand": { "script": "bun run build", "cwd": "../frontend" }
  },
  "app": {
    "windows": [
      {
        "label": "hub",
        "title": "FenixHub",
        "width": 820,
        "height": 185,
        "minWidth": 280,
        "minHeight": 34,
        "maxWidth": 820,
        "maxHeight": 185,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": true
      },
      {
        "label": "settings",
        "title": "FenixHub — Ajustes",
        "url": "/#settings",
        "width": 560,
        "height": 560,
        "minWidth": 560,
        "minHeight": 560,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCAL/**", "$APPDATA/**", "$HOME/**"]
      }
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "tooltip": "FenixHub — portapapeles efímero"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
